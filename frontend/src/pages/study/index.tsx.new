import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { useAuth } from '../../hooks/useAuth';
import { useFetch } from '../../hooks/useFetch';
import MainLayout from '../../components/Layout';
import { studyAPI, studyTasksAPI } from '../../services/api';
import {
  Flex,
  Text,
  Button,
  Card,
  TextField,
  TextArea,
  Tabs,
  Badge,
  Checkbox,
  IconButton,
  Select,
  Dialog,
  Progress,
  Heading,
  Box,
} from '@radix-ui/themes';
import { FiPlus, FiTrash2, FiCheckCircle, FiList, FiBookOpen, FiTrendingUp } from 'react-icons/fi';
import './study.css';

const XP_REWARD = 10;

export default function StudySessions() {
  const { user, updateUser } = useAuth();
  const [tasks, setTasks] = useState<any[]>([]);
  const [sessions, setSessions] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [showTaskForm, setShowTaskForm] = useState(false);
  const [showSessionForm, setShowSessionForm] = useState(false);
  const [newTaskTitle, setNewTaskTitle] = useState('');
  const [newTaskDesc, setNewTaskDesc] = useState('');
  const [newTaskPriority, setNewTaskPriority] = useState('medium');
  const [xpPopup, setXpPopup] = useState<{ show: boolean; amount: number }>({ show: false, amount: 0 });
  const [formData, setFormData] = useState({
    technology: '',
    duration: 0,
    focus: 50,
    productivity: 50,
    notes: '',
  });

  const loadData = async () => {
    setLoading(true);
    try {
      const [tasksRes, sessionsRes] = await Promise.all([
        studyTasksAPI.getAll(),
        studyAPI.getAll(),
      ]);
      setTasks(tasksRes.data || []);
      setSessions(sessionsRes.data || []);
    } catch (error) {
      console.error('Erro ao carregar dados:', error);
    }
    setLoading(false);
  };

  useEffect(() => {
    loadData();
  }, []);

  const handleAddTask = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newTaskTitle.trim()) return;
    try {
      await studyTasksAPI.create({
        title: newTaskTitle.trim(),
        description: newTaskDesc.trim(),
        priority: newTaskPriority,
        xpReward: XP_REWARD,
      });
      setNewTaskTitle('');
      setNewTaskDesc('');
      setNewTaskPriority('medium');
      setShowTaskForm(false);
      loadData();
    } catch (error) {
      console.error('Erro ao criar tarefa:', error);
    }
  };

  const handleCompleteTask = async (task: any) => {
    try {
      const { data } = await studyTasksAPI.complete(task._id);
      updateUser({ ...user, xp: data.newXp, level: data.newLevel });
      setXpPopup({ show: true, amount: data.xpGained });
      loadData();
      setTimeout(() => setXpPopup({ show: false, amount: 0 }), 2000);
    } catch (error) {
      console.error('Erro ao completar tarefa:', error);
    }
  };

  const handleToggleTask = async (task: any) => {
    try {
      const { data } = await studyTasksAPI.toggle(task._id);
      updateUser({ ...user, xp: data.newXp, level: data.newLevel });
      loadData();
    } catch (error) {
      console.error('Erro ao alternar tarefa:', error);
    }
  };

  const handleDeleteTask = async (id: string) => {
    try {
      await studyTasksAPI.delete(id);
      loadData();
    } catch (error) {
      console.error('Erro ao deletar tarefa:', error);
    }
  };

  const handleInputChange = (e: any) => {
    const { name, value } = e.target;
    setFormData((prev) => ({
      ...prev,
      [name]:
        name === 'duration' || name === 'focus' || name === 'productivity'
          ? parseInt(value) || 0
          : value,
    }));
  };

  const handleAddSession = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!formData.technology.trim() || formData.duration <= 0) return;
    try {
      const { data } = await studyAPI.create({
        ...formData,
        userId: user?.id,
      });
      updateUser({ ...user, xp: (user?.xp || 0) + (data.xpGained || 10) });
      setFormData({ technology: '', duration: 0, focus: 50, productivity: 50, notes: '' });
      setShowSessionForm(false);
      loadData();
    } catch (error) {
      console.error('Erro ao criar sess├úo:', error);
    }
  };

  const handleDeleteSession = async (id: string) => {
    try {
      await studyAPI.delete(id);
      loadData();
    } catch (error) {
      console.error('Erro ao deletar sess├úo:', error);
    }
  };

  const pendingTasks = tasks.filter((t) => !t.completed);
  const completedTasks = tasks.filter((t) => t.completed);
  const xpProgress = (user?.xp || 0) % 100;
  const nextLevelXp = 100;

  return (
    <MainLayout>
      <Flex direction="column" gap="6" className="study-page">
        {/* XP Popup Toast */}
        <AnimatePresence>
          {xpPopup.show && (
            <motion.div
              initial={{ opacity: 0, scale: 0.8, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.8 }}
              className="xp-popup"
            >
              <Flex align="center" gap="3">
                <FiTrendingUp size={28} style={{ color: 'var(--accent-9)' }} />
                <Text size="4" weight="bold" color="green">
                  +{xpPopup.amount} XP!
                </Text>
              </Flex>
              <Text size="1" color="gray">
                Tarefa completada!
              </Text>
            </motion.div>
          )}
        </AnimatePresence>

        {/* Header com XP */}
        <Flex justify="between" align="center" wrap="wrap" gap="4">
          <Box>
            <Heading size="8" mb="1">
              Estudos
            </Heading>
            <Text size="2" color="gray">
              Complete tarefas e ganhe XP. Cada tarefa vale {XP_REWARD} XP.
            </Text>
          </Box>
          <Card size="2" className="xp-card">
            <Flex align="center" gap="4">
              <Flex direction="column" gap="1">
                <Text size="1" color="gray">
                  Seu XP
                </Text>
                <Flex align="baseline" gap="2">
                  <Text size="6" weight="bold">
                    {user?.xp || 0}
                  </Text>
                  <Text size="1" color="gray">
                    XP
                  </Text>
                </Flex>
              </Flex>
              <Box style={{ minWidth: 120 }}>
                <Text size="1" color="gray" mb="1">
                  N├¡vel {user?.level || 1}
                </Text>
                <Progress value={xpProgress} size="1" />
                <Text size="1" color="gray">
                  {xpProgress}/{nextLevelXp} para pr├│ximo n├¡vel
                </Text>
              </Box>
            </Flex>
          </Card>
        </Flex>

        <Tabs.Root defaultValue="tasks">
          <Tabs.List size="2">
            <Tabs.Trigger value="tasks">
              <FiList size={16} />
              Tarefas ({pendingTasks.length})
            </Tabs.Trigger>
            <Tabs.Trigger value="sessions">
              <FiBookOpen size={16} />
              Sess├Áes de Estudo
            </Tabs.Trigger>
          </Tabs.List>

          <Box pt="4">
            <Tabs.Content value="tasks">
              {/* Add Task Form */}
              {showTaskForm ? (
                <Card size="2" mb="4">
                  <form onSubmit={handleAddTask}>
                    <Flex direction="column" gap="3">
                      <TextField.Root
                        placeholder="Ex: Completar curso de React Hooks"
                        value={newTaskTitle}
                        onChange={(e) => setNewTaskTitle(e.target.value)}
                        size="3"
                        autoFocus
                      />
                      <TextArea
                        placeholder="Descri├º├úo (opcional)"
                        value={newTaskDesc}
                        onChange={(e) => setNewTaskDesc(e.target.value)}
                        rows={2}
                      />
                      <Flex gap="2" align="center">
                        <Select.Root
                          value={newTaskPriority}
                          onValueChange={setNewTaskPriority}
                        >
                          <Select.Trigger placeholder="Prioridade" style={{ width: 130 }} />
                          <Select.Content>
                            <Select.Item value="low">Baixa</Select.Item>
                            <Select.Item value="medium">M├®dia</Select.Item>
                            <Select.Item value="high">Alta</Select.Item>
                          </Select.Content>
                        </Select.Root>
                        <Badge color="green">+{XP_REWARD} XP ao completar</Badge>
                        <Flex gap="2" ml="auto">
                          <Button
                            type="button"
                            variant="soft"
                            color="gray"
                            onClick={() => setShowTaskForm(false)}
                          >
                            Cancelar
                          </Button>
                          <Button type="submit">
                            <FiPlus /> Adicionar
                          </Button>
                        </Flex>
                      </Flex>
                    </Flex>
                  </form>
                </Card>
              ) : (
                <Button
                  size="3"
                  variant="soft"
                  mb="4"
                  onClick={() => setShowTaskForm(true)}
                >
                  <FiPlus /> Nova Tarefa
                </Button>
              )}

              {/* Task List */}
              {loading ? (
                <Text>Carregando...</Text>
              ) : tasks.length === 0 ? (
                <Card size="3" className="empty-state-card">
                  <Flex direction="column" align="center" gap="3" py="6">
                    <FiList size={48} style={{ color: 'var(--gray-8)' }} />
                    <Heading size="4">Nenhuma tarefa ainda</Heading>
                    <Text color="gray" align="center">
                      Crie sua primeira tarefa e comece a ganhar XP!
                    </Text>
                    <Button onClick={() => setShowTaskForm(true)}>
                      <FiPlus /> Criar tarefa
                    </Button>
                  </Flex>
                </Card>
              ) : (
                <Flex direction="column" gap="2">
                  {pendingTasks.map((task) => (
                    <motion.div
                      key={task._id}
                      initial={{ opacity: 0, x: -10 }}
                      animate={{ opacity: 1, x: 0 }}
                      layout
                    >
                      <Card size="2" className="task-card">
                        <Flex align="center" gap="3" style={{ width: '100%' }}>
                          <Checkbox
                            size="3"
                            checked={false}
                            onCheckedChange={() => handleCompleteTask(task)}
                          />
                          <Flex direction="column" gap="1" style={{ flex: 1 }}>
                            <Text size="3" weight="medium">
                              {task.title}
                            </Text>
                            {task.description && (
                              <Text size="1" color="gray">
                                {task.description}
                              </Text>
                            )}
                          </Flex>
                          <Badge
                            color={
                              task.priority === 'high'
                                ? 'red'
                                : task.priority === 'medium'
                                ? 'yellow'
                                : 'gray'
                            }
                            variant="soft"
                          >
                            {task.priority}
                          </Badge>
                          <Badge color="green" variant="soft">
                            +{task.xpReward} XP
                          </Badge>
                          <Dialog.Root>
                            <Dialog.Trigger>
                              <IconButton
                                variant="ghost"
                                color="red"
                                size="2"
                                onClick={(e) => e.stopPropagation()}
                              >
                                <FiTrash2 />
                              </IconButton>
                            </Dialog.Trigger>
                            <Dialog.Content>
                              <Dialog.Title>Remover tarefa?</Dialog.Title>
                              <Dialog.Description>
                                Esta a├º├úo n├úo pode ser desfeita.
                              </Dialog.Description>
                              <Flex gap="3" mt="4" justify="end">
                                <Dialog.Close>
                                  <Button variant="soft" color="gray">
                                    Cancelar
                                  </Button>
                                </Dialog.Close>
                                <Dialog.Close>
                                  <Button
                                    color="red"
                                    onClick={() => handleDeleteTask(task._id)}
                                  >
                                    Remover
                                  </Button>
                                </Dialog.Close>
                              </Flex>
                            </Dialog.Content>
                          </Dialog.Root>
                        </Flex>
                      </Card>
                    </motion.div>
                  ))}

                  {completedTasks.length > 0 && (
                    <>
                      <Text size="2" color="gray" mt="4" mb="2">
                        Completadas ({completedTasks.length})
                      </Text>
                      {completedTasks.map((task) => (
                        <motion.div
                          key={task._id}
                          initial={{ opacity: 0 }}
                          animate={{ opacity: 1 }}
                          layout
                        >
                          <Card size="2" className="task-card completed">
                            <Flex align="center" gap="3" style={{ width: '100%' }}>
                              <Checkbox
                                size="3"
                                checked={true}
                                onCheckedChange={() => handleToggleTask(task)}
                              />
                              <Flex
                                direction="column"
                                gap="1"
                                style={{ flex: 1, opacity: 0.7 }}
                              >
                                <Text size="3" style={{ textDecoration: 'line-through' }}>
                                  {task.title}
                                </Text>
                              </Flex>
                              <FiCheckCircle size={20} style={{ color: 'var(--green-9)' }} />
                              <IconButton
                                variant="ghost"
                                color="gray"
                                size="2"
                                onClick={() => handleDeleteTask(task._id)}
                              >
                                <FiTrash2 />
                              </IconButton>
                            </Flex>
                          </Card>
                        </motion.div>
                      ))}
                    </>
                  )}
                </Flex>
              )}
            </Tabs.Content>

            <Tabs.Content value="sessions">
              {showSessionForm ? (
                <Card size="2" mb="4">
                  <Heading size="4" mb="3">
                    Nova Sess├úo de Estudo
                  </Heading>
                  <form onSubmit={handleAddSession}>
                    <Flex direction="column" gap="3">
                      <Flex gap="3" wrap="wrap">
                        <Box style={{ flex: 1, minWidth: 200 }}>
                          <Text size="1" mb="1" as="div">
                            Tecnologia
                          </Text>
                          <TextField.Root
                            name="technology"
                            placeholder="React, JavaScript..."
                            value={formData.technology}
                            onChange={handleInputChange}
                          />
                        </Box>
                        <Box style={{ width: 120 }}>
                          <Text size="1" mb="1" as="div">
                            Dura├º├úo (min)
                          </Text>
                          <TextField.Root
                            name="duration"
                            type="number"
                            value={formData.duration || ''}
                            onChange={handleInputChange}
                          />
                        </Box>
                      </Flex>
                      <Flex gap="3">
                        <Box style={{ flex: 1 }}>
                          <Text size="1" mb="1" as="div">
                            Foco: {formData.focus}%
                          </Text>
                          <input
                            type="range"
                            name="focus"
                            min="0"
                            max="100"
                            value={formData.focus}
                            onChange={handleInputChange}
                            className="radix-slider"
                          />
                        </Box>
                        <Box style={{ flex: 1 }}>
                          <Text size="1" mb="1" as="div">
                            Produtividade: {formData.productivity}%
                          </Text>
                          <input
                            type="range"
                            name="productivity"
                            min="0"
                            max="100"
                            value={formData.productivity}
                            onChange={handleInputChange}
                            className="radix-slider"
                          />
                        </Box>
                      </Flex>
                      <Box>
                        <Text size="1" mb="1" as="div">
                          Notas
                        </Text>
                        <TextArea
                          name="notes"
                          placeholder="O que voc├¬ aprendeu?"
                          value={formData.notes}
                          onChange={handleInputChange}
                          rows={3}
                        />
                      </Box>
                      <Flex gap="2">
                        <Button type="submit">Salvar Sess├úo</Button>
                        <Button
                          type="button"
                          variant="soft"
                          color="gray"
                          onClick={() => setShowSessionForm(false)}
                        >
                          Cancelar
                        </Button>
                      </Flex>
                    </Flex>
                  </form>
                </Card>
              ) : (
                <Button
                  size="3"
                  variant="soft"
                  mb="4"
                  onClick={() => setShowSessionForm(true)}
                >
                  <FiPlus /> Nova Sess├úo
                </Button>
              )}

              {sessions.length === 0 ? (
                <Card size="3" className="empty-state-card">
                  <Flex direction="column" align="center" gap="3" py="6">
                    <FiBookOpen size={48} style={{ color: 'var(--gray-8)' }} />
                    <Heading size="4">Nenhuma sess├úo registrada</Heading>
                    <Text color="gray" align="center">
                      Registre suas sess├Áes de estudo para acompanhar o progresso.
                    </Text>
                  </Flex>
                </Card>
              ) : (
                <Flex direction="column" gap="2">
                  {sessions.map((session: any) => (
                    <Card key={session._id} size="2">
                      <Flex justify="between" align="start" wrap="wrap" gap="3">
                        <Box>
                          <Text size="3" weight="bold">
                            {session.technology}
                          </Text>
                          <Text size="1" color="gray">
                            {new Date(session.createdAt).toLocaleDateString('pt-BR')} ÔÇó{' '}
                            {session.duration} min
                          </Text>
                          {session.notes && (
                            <Text size="2" mt="2" as="p">
                              {session.notes}
                            </Text>
                          )}
                        </Box>
                        <Flex gap="2" align="center">
                          <Badge color="blue">Foco: {session.focus}%</Badge>
                          <Badge color="green">Prod: {session.productivity}%</Badge>
                          <IconButton
                            variant="ghost"
                            color="red"
                            size="2"
                            onClick={() => handleDeleteSession(session._id)}
                          >
                            <FiTrash2 />
                          </IconButton>
                        </Flex>
                      </Flex>
                    </Card>
                  ))}
                </Flex>
              )}
            </Tabs.Content>
          </Box>
        </Tabs.Root>
      </Flex>
    </MainLayout>
  );
}
